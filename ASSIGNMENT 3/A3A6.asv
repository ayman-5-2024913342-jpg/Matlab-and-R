clc
close all
clear all

figure(1)

fimplicit(@(x,y) x.^(2).^(1/3) + y.^(2).^(1/3) - 1)



x = @(t) cos^3.*(t)
y = @(t) sin^3.*(t)

%fplot(x,y, [-pi pi])

fplot(x, y, [-pi pi], 'r--', 'LineWidth', 2);

legend("Implicit curve", "Parametric curve");
xlabel('x');
ylabel('y');
title('Implicit vs Parametric Curve');
