clc; 
close all;
clear all;

A = readmatrix("a.txt")
b = readmatrix("b.txt")

%======================Part I=================================
Aug = [A, b];
R = rref(Aug)
x_exact = R(:, end)

%====================Part II==================================
%Diagonally Dominant
[~,max_cols] = max(abs(A), [] , 2);
A_dom (max_cols,:) = A
b_dom (max_cols) = b;

jacobi(A, b, 0, 10e-5, 100)

function [x, iter, err] = jacobi(A, b, x0, tol, max_iter)
    tol = 10^-5;
    n = length(b);
    x = x0;
    D = diag(A); 
    R = A - diag(A);
    
    for i = 1:length(D)
        if abs(D(i)) == 0
            disp("Zero on diagnoal. Rearrange equations");
        end
    end

    for iter = 1:max_iter
       x_new = (b - R*x) ./ D;
       
       err = norm(x_new - x, inf);

       if (max(abs(x_new - x) ./ abs(x_new))) < tol
           return;
       end
       x = x_new;
    end
end 